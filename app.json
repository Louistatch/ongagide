{
  "name": "ongagide",
  "description": "Site web de l'ONG AGIDE",
  "env": {
    "DISABLE_COLLECTSTATIC": {
      "description": "Désactiver la collecte des fichiers statiques",
      "value": "1"
    },
    "DEBUG": {
      "description": "Activer le mode débogage",
      "value": "False"
    },
    "ALLOWED_HOSTS": {
      "description": "Hôtes autorisés",
      "value": "localhost,127.0.0.1,ongagide.onrender.com,*.digitaloceanspaces.com,agide-app-oyzs9.ondigitalocean.app,*.ondigitalocean.app,agidetogo.com,www.agidetogo.com"
    },
    "DO_SQLITE_PATH": {
      "description": "Chemin vers le fichier SQLite sur DigitalOcean",
      "value": "/data/db.sqlite3"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "services": [
    {
      "name": "web",
      "environment_slug": "python",
      "run_command": "python manage.py migrate --noinput && gunicorn agide.wsgi:application",
      "source_dir": "/",
      "instance_size_slug": "basic-xxs",
      "instance_count": 1,
      "routes": [{"path": "/"}],
      "volumes": ["sqlite-data"]
    }
  ],
  "volumes": [
    {
      "name": "sqlite-data",
      "mount_path": "/data",
      "size_gigabytes": 1
    }
  ]
}