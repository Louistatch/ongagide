    },
    "SUPABASE_KEY": {
      "description": "Clé anonyme Supabase (ANON key)",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB0bW9hYmFvYnFkd3NyaXdsaWNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDYwOTc0NjEsImV4cCI6MjA2MTY3MzQ2MX0.xrFeNs2YeUxTOdPF2bYvXj7kk_CZWe4Fe5CcDBuSvrM"
    },
    "SUPABASE_JWT_SECRET": {
      "description": "Service Role Key Supabase (JWT secret)",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc0NjA5NzQ2MSwiZXhwIjoyMDYxNjczNDYxfQ.KQ98qbAx4NPsLuQQ_9LyP7wQ-FfgDpdeVDWzneltyQQ"
